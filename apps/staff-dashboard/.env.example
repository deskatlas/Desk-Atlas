# ============================================================================
# Staff Dashboard - Local Development Configuration (:3003)
# Copy this file to .env.local for local development
# ============================================================================

# Supabase Backend Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="DeskAtlas <bookings@thedeskatlas.com>"

# Google Form Survey URL
SURVEY_FORM_URL="https://forms.gle/LogUg86kGi2pveEZ8"

# Application URLs (Local Development)
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000
DESKATLAS_PUBLIC_APP_URL=http://localhost:3001
TRACKING_BASE_URL=http://localhost:3001
BOOKING_ACCESS_BASE_URL=http://localhost:3001/api/booking
# SPEC-4: server-only, disabled until SPEC-6 release gates pass.
RAG_ENABLED=false
KB_ENABLED=false
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=
RAG_CAPABILITY_SECRET=
RAG_SCOPE_ID=deskatlas
RAG_EMBEDDING_FINGERPRINT=
RAG_MIN_SIMILARITY=
RAG_REQUEST_DEADLINE_MS=15000
RAG_CAPACITY=5
# MS-44: experimental standalone SOP routing. Roll back by setting false.
RAG_SOP_FAST_PATH=false
# MS-55: matching shared gateway/service/migration required; acceptance pending.
RAG_HYBRID_RETRIEVAL=false
RAG_HYBRID_MODE=fused
RAG_HYBRID_QUERY_MODE=expanded

# MS-57: server-only admission, default off until independent acceptance.
# Restart the gateway after configuration changes; retrieval and tools stay usable.
RAG_SYNTHESIS_ENABLED=false

# MS65: requires migration 028, matching service and rag:evidence-readiness.
# Keep legacy or ms59-v1 only for explicitly compatible older corpora.
RAG_EVIDENCE_CONTRACT=ms65-v1
