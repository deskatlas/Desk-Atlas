# ============================================================================
# Admin Portal - Local Development Configuration (:3000)
# Copy this file to .env.local for local development
# ============================================================================

# Supabase Backend Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="DeskAtlas <bookings@thedeskatlas.com>"

# MS83: admin Vercel Production cron runs every minute (Pro/Enterprise).
# Generate a random server-only value; Vercel sends it as a Bearer credential.
CRON_SECRET=
# Optional independent credential for manually invoking the same worker.
REWARDS_WORKER_SECRET=

# Google Form Survey URL
SURVEY_FORM_URL="https://forms.gle/LogUg86kGi2pveEZ8"

# Application URLs (Local Development)
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:3003
DESKATLAS_PUBLIC_APP_URL=http://localhost:3001
TRACKING_BASE_URL=http://localhost:3001
BOOKING_ACCESS_BASE_URL=http://localhost:3001/api/booking

# SPEC-4: server-only, disabled until SPEC-6 release gates pass.
RAG_ENABLED=false
KB_ENABLED=false

RAG_SERVICE_URL=http://127.0.0.1:8000
# SPEC-6: private Cloud Run transport. Preview: vercel-oidc (dev only).
# Production: vercel-oidc-production with the separate vercel-production pool.
RAG_GOOGLE_AUTH=
RAG_GOOGLE_WORKLOAD_PROVIDER=
RAG_GOOGLE_SERVICE_ACCOUNT=
RAG_SERVICE_TOKEN=
RAG_CAPABILITY_SECRET=

RAG_SCOPE_ID=deskatlas
RAG_EMBEDDING_FINGERPRINT=

RAG_MIN_SIMILARITY=
RAG_REQUEST_DEADLINE_MS=15000
RAG_CAPACITY=5
# MS-55: keep disabled until the MS-54 baseline and independent retrieval gate pass.
RAG_HYBRID_RETRIEVAL=false
# Frozen evaluation controls. Production candidate default: fused/expanded.
RAG_HYBRID_MODE=fused
RAG_HYBRID_QUERY_MODE=expanded

# SPEC-5: enable only after applying migrations 015/016 and provisioning the worker.
KB_ENABLED=false
KB_SCOPE_ID=deskatlas
# Generate a separate random server-only credential, at least 32 characters.
KB_WORKER_TOKEN=
# Canonical SHA-256 of the embedding object in services/rag/models.json.
RAG_EMBEDDING_FINGERPRINT=

# MS-54: content-free request diagnostics, authenticated responses only.
RAG_DIAGNOSTICS_ENABLED=false

# MS-57: server-only admission, default off until independent acceptance.
# Restart the gateway after configuration changes; retrieval and tools stay usable.
RAG_SYNTHESIS_ENABLED=false

# MS65: requires migration 028, matching service and rag:evidence-readiness.
# Keep legacy or ms59-v1 only for explicitly compatible older corpora.
RAG_EVIDENCE_CONTRACT=ms65-v1

# PRD-F26/F27: requires prepared migrations, accepted corpus and matching API.
RAG_GUIDANCE_FAST_PATH=false
RAG_PREPARED_SUPPORT=false
RAG_INTERNAL_CATALOG_DISCOVERY=false
RAG_PREPARATION_FINGERPRINT=
KB_SUPPORT_PREPARATION_ENABLED=false
