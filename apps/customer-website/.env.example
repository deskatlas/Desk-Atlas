# ============================================================================
# Customer Website - Local Development Configuration (:3001)
# Copy this file to .env.local for local development
# ============================================================================

# Supabase Backend Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="DeskAtlas <bookings@thedeskatlas.com>"

# Google Form Survey URL
SURVEY_FORM_URL="https://forms.gle/LogUg86kGi2pveEZ8"

# Application URLs (Local Development)
DESKATLAS_PUBLIC_APP_URL=http://localhost:3001
TRACKING_BASE_URL=http://localhost:3001
PAYMENT_SESSION_BASE_URL=http://localhost:3001/pay
BOOKING_ACCESS_BASE_URL=http://localhost:3001/api/booking

# MS76-MS78: CUSTOMER knowledge is shared; private bookings still require verification.
# Copy matching RAG service URL/token/capability secret/scope/fingerprint/similarity from the admin gateway.
# Set REWARDS_RATE_LIMIT_SECRET to a stable random secret (at least 32 bytes), identical across customer replicas.
# Never prefix server secrets with NEXT_PUBLIC_.
# Production header below assumes Vercel. For another ingress use its overwritten
# cf-connecting-ip or x-real-ip header and block direct bypass.
# NEXT_PUBLIC_ flag changes require rebuild; server env changes require restart/redeploy.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=
RAG_CAPABILITY_SECRET=
RAG_SCOPE_ID=deskatlas
RAG_EMBEDDING_FINGERPRINT=
RAG_MIN_SIMILARITY=
RAG_REQUEST_DEADLINE_MS=15000
CUSTOMER_ASSISTANT_ENABLED=false
# PRD-F26/F27: bounded current customer catalog, separately accepted before rollout.
CUSTOMER_ASSISTANT_CATALOG_DISCOVERY=false
CUSTOMER_ASSISTANT_VERIFIED_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ASSISTANT_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ASSISTANT_VERIFIED_ENABLED=false
CUSTOMER_ASSISTANT_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CUSTOMER_ASSISTANT_TRUSTED_IP_HEADER=
REWARDS_RATE_LIMIT_SECRET=
