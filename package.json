{
  "name": "deskatlas-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:admin": "pnpm --filter @deskatlas/admin-portal dev",
    "dev:customer": "pnpm --filter @deskatlas/customer-website dev",
    "dev:kiosk": "pnpm --filter @deskatlas/kiosk dev",
    "dev:staff": "pnpm --filter @deskatlas/staff-dashboard dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "bootstrap:admin": "tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --outDir node_modules/.cache/deskatlas-bootstrap-admin --rootDir . scripts/bootstrap-admin.ts && node node_modules/.cache/deskatlas-bootstrap-admin/scripts/bootstrap-admin.js",
    "seed:admin": "pnpm bootstrap:admin",
    "bootstrap:staff": "tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --outDir node_modules/.cache/deskatlas-bootstrap-staff --rootDir . scripts/bootstrap-staff.ts && node node_modules/.cache/deskatlas-bootstrap-staff/scripts/bootstrap-staff.js",
    "seed:staff": "pnpm bootstrap:staff",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:t01": "vitest run tests/t01",
    "test:t02": "vitest run tests/t02",
    "test:t03": "vitest run tests/t03",
    "test:t04": "vitest run tests/t04",
    "test:t05": "vitest run tests/t05",
    "test:t06": "vitest run tests/t06",
    "test:t07": "vitest run tests/t07",
    "test:t08": "vitest run tests/t08",
    "test:t09": "vitest run tests/t09",
    "test:t10": "vitest run tests/t10",
    "test:t11": "vitest run tests/t11",
    "test:t12": "vitest run tests/t12"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.0",
    "mocha": "^11.8.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pngjs": "^7.0.0"
  }
}
