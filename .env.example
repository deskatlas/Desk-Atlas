# ============================================================================
# DeskAtlas Environment Configuration
# ============================================================================

# Supabase Backend Connection
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to client-side code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial Administrator Bootstrap (used by `pnpm bootstrap:admin`)
ADMIN_EMAIL=admin@deskatlas.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_DISPLAY_NAME="Admin User"

# Resend Transactional Email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL="DeskAtlas <bookings@your-verified-domain.com>"
TRANSACTIONAL_EMAIL_WEBHOOK_URL=
# Admin Vercel project only: minute-level notification cron authentication.
CRON_SECRET=
REWARDS_WORKER_SECRET=
SURVEY_FORM_URL="https://forms.gle/LogUg86kGi2pveEZ8"

# Application URLs (Local Development)
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000
DESKATLAS_PUBLIC_APP_URL=http://localhost:3001
TRACKING_BASE_URL=http://localhost:3001
NEXT_PUBLIC_KIOSK_URL=http://localhost:3002/kiosk
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:3003
BOOKING_ACCESS_BASE_URL=http://localhost:3001/api/booking

# SPEC-6: server-only feature controls. Enable only after phase evidence passes.
RAG_ENABLED=false
KB_ENABLED=false
# MS65 reader requires migration 028 and a compatible service. Run rag:evidence-readiness before enabling.
RAG_EVIDENCE_CONTRACT=ms65-v1
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=
RAG_CAPABILITY_SECRET=
RAG_SCOPE_ID=deskatlas
RAG_EMBEDDING_FINGERPRINT=
RAG_VECTOR_DIMENSIONS=1024
# CPU evaluation defaults. Serving admission/deadlines require integration benchmarking.
RAG_REQUEST_DEADLINE_MS=15000
RAG_CAPACITY=1
RAG_QUEUE_CAPACITY=5
RAG_CONTEXT_BUDGET=4096
RAG_MIN_SIMILARITY=

# MS-44: opt-in planning experiment; enable only for equivalent local quality/latency runs.
RAG_SOP_FAST_PATH=false
# Python service generation budgets, unchanged from the comparison baseline.
RAG_PLAN_MAX_TOKENS=1200
RAG_ANSWER_MAX_TOKENS=1200
# Compact extractive selection uses IDs; external exact-quote contract is unchanged.
RAG_COMPACT_SELECTION=true
RAG_SELECTION_MAX_TOKENS=128
# 0 preserves the CPU baseline. Local serve_local.py --gpu opts into -1 (auto).
RAG_MODEL_GPU_LAYERS=0
RAG_MODEL_KEEP_ALIVE=10m
RAG_PRELOAD_MODEL=false

# MS78: private activation remains off pending MS79; the quota HMAC key is server-only.
CUSTOMER_ASSISTANT_VERIFIED_ENABLED=false

# MS78: private activation remains off pending MS79; the quota HMAC key is server-only.
REWARDS_RATE_LIMIT_SECRET=

# MS77: keep activation off until MS79 deployment-wide acceptance.
CUSTOMER_ASSISTANT_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ASSISTANT_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ASSISTANT_VERIFIED_ENABLED=false
# Exact comma-separated origins, for example http://localhost:3001 during development.
CUSTOMER_ASSISTANT_ALLOWED_ORIGINS=
# Set only when ingress overwrites this header and direct ingress bypass is blocked.
# Allowed: x-vercel-forwarded-for, cf-connecting-ip, x-real-ip. No forwarded chain parsing.
CUSTOMER_ASSISTANT_TRUSTED_IP_HEADER=
