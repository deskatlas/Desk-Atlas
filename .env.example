# ============================================================================
# DeskAtlas Environment Configuration
# ============================================================================

# Supabase Backend Connection
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to client-side code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial Administrator Bootstrap (used by `pnpm bootstrap:admin` / `pnpm seed:admin`)
ADMIN_EMAIL=admin@deskatlas.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_DISPLAY_NAME="Admin User"

# Resend Transactional Email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL="DeskAtlas <bookings@your-verified-domain.com>"
TRANSACTIONAL_EMAIL_WEBHOOK_URL=
SURVEY_FORM_URL="https://forms.gle/LogUg86kGi2pveEZ8"

# Application URLs (Local Development)
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3000
DESKATLAS_PUBLIC_APP_URL=http://localhost:3001
TRACKING_BASE_URL=http://localhost:3001
NEXT_PUBLIC_KIOSK_URL=http://localhost:3002/kiosk
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:3003
BOOKING_ACCESS_BASE_URL=http://localhost:3001/api/booking

