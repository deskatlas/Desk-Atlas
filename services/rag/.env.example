RAG_SERVICE_TOKEN=
RAG_CAPABILITY_SECRET=
RAG_SCOPE_ID=deskatlas
# Explicit provider selection. DeepInfra also requires the model below.
RAG_MODEL_PROVIDER=ollama
# Separate embedding provider. Requires complete re-index before activation.
RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_PROVIDER=deepinfra
# RAG_MODEL_PROVIDER=deepinfra
# RAG_ANSWER_MODEL=Qwen/Qwen3-32B
# DEEPINFRA_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
RAG_ANSWER_MODEL=qwen3:4b
RAG_ANSWER_DIGEST=359d7dd4bcdab3d86b87d73ac27966f4dbb9f5efdfcc75d34a8764a09474fae7
KB_ENABLED=false
RAG_EMBEDDING_FINGERPRINT=

# Optional launcher overrides in services/rag/.env.local.
# pnpm rag:api and pnpm rag:worker also read apps/admin-portal/.env.local.
# Leave secrets in the admin environment or set matching values locally.
KB_GATEWAY_URL=http://127.0.0.1:3000
KB_WORKER_TOKEN=

# Optional measured local GPU profile; requires the installed Vulkan backend.
# pnpm rag:api starts/reuses the existing isolated GPU launcher for this profile.
# OLLAMA_URL=http://127.0.0.1:11435
# RAG_MODEL_GPU_LAYERS=-1
# RAG_PRELOAD_MODEL=true
# RAG_MODEL_KEEP_ALIVE=-1
# GPU launcher defaults to the measured 64-token prompt batch. CPU default is 1024.
# RAG_MODEL_BATCH_SIZE=64
# Scope/evidence mapping defaults to 384 output tokens; compact verdicts use 128.
# Optional shared override, including scoped selection:
# RAG_SELECTION_MAX_TOKENS=384

# MS-52: all runs one ingestion lane plus one independent cleanup lane.
# purge requires only the gateway and worker authority; no model is loaded.
KB_WORKER_MODE=all
# MS77: isolated customer routes remain disabled until MS79 acceptance.
CUSTOMER_ASSISTANT_ENABLED=false
